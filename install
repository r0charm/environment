#!/bin/bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v stow &>/dev/null; then
  echo "error: GNU stow is not installed (brew install stow)" >&2
  exit 1
fi

stow -R -v -t ~ -d "$DOTFILES_DIR/home" .

# Cursor (stored in .config/cursor, symlinked to Mac app path)
CURSOR_SETTINGS_DIR="$HOME/Library/Application Support/Cursor/User"
mkdir -p "$CURSOR_SETTINGS_DIR"
ln -sf "$HOME/.config/cursor/settings.json" "$CURSOR_SETTINGS_DIR/settings.json"
