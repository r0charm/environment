if command -v eza &>/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lh --group-directories-first --git'
  alias la='eza -lah --group-directories-first --git'
  alias tree='eza --tree'
fi

if command -v bat &>/dev/null; then
  alias cat='bat --style=plain'
  alias less='bat --style=full --paging=always'
fi

if command -v zoxide &>/dev/null; then
  # Claude Code's shell snapshot restores zoxide's functions but not chpwd_functions,
  # so the doctor false-positives on every `z`. Disable it; hook is registered fine in real shells.
  export _ZO_DOCTOR=0
  eval "$(zoxide init zsh)"
  alias cd='z'
fi

# kubectl completions
[[ $commands[kubectl] ]] && source <(kubectl completion zsh)

# LM Studio CLI (lms)
[ -d "$HOME/.lmstudio/bin" ] && path+=("$HOME/.lmstudio/bin")
